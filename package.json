{
  "name": "prova02-integration-test-guilhermegoulart",
  "version": "1.0.0",
  "description": "API testing with a simple integration between JestJS and PactumJS.",
  "main": "index.js",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.6",
    "http-status-codes": "^2.2.0",
    "jest": "^30.5.2",
    "jest-html-reporters": "^3.1.7",
    "mkdirp": "^3.0.1",
    "pactum": "^3.9.1",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "5.5.4"
  },
  "scripts": {
    "clean": "rimraf ./output && mkdirp ./output",
    "format": "prettier --write \"**/**.[jt]s?(x)\"",
    "verify": "prettier --check \"**/**.[jt]s?(x)\"",
    "eslint": "eslint \"**/**.[jt]s?(x)\" -o output/eslint.html -f html",
    "scenario": "jest serve_rest.spec.ts --config ./jest.config.js",
    "test:contact": "jest contact_list.spec.ts --config ./jest.config.js",
    "test:dashboard": "jest --config ./jest.dashboard.config.js",
    "test": "jest --config ./jest.config.js",
    "ci": "npm run clean && npm run format && npm run verify && npm run eslint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermegm-2k26/prova02-integration-test-GuilhermeGoulart.git"
  },
  "author": "Guilherme Goulart",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/guilhermegm-2k26/prova02-integration-test-GuilhermeGoulart/issues"
  },
  "homepage": "https://github.com/guilhermegm-2k26/prova02-integration-test-GuilhermeGoulart#readme"
}
